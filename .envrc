#!/usr/bin/env bash
# Notices shown when entering the home-manager repo:
#   - upstream commits that still need to be pulled
#   - local changes (committed or not) that are not yet applied via `home-manager switch`

hm_notice() {
  # Fetch quietly; never prompt and never block the shell for long.
  if ! timeout 8 env GIT_TERMINAL_PROMPT=0 \
      GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=4" \
      git fetch --quiet 2>/dev/null; then
    log_error "home-manager: git fetch failed (offline or SSH agent locked?)"
  fi

  local upstream behind ahead
  if upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
    behind="$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
    ahead="$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
    if ((behind > 0)); then
      log_error "home-manager: $behind new commit(s) on $upstream -> run: git pull"
    fi
    if ((ahead > 0)); then
      log_status "home-manager: $ahead local commit(s) not pushed to $upstream"
    fi
  fi

  # Compare the current tree's flake source path with the one recorded on the last switch.
  local applied_file="$HOME/.local/state/home-manager-applied-source"
  local current="" applied="" meta
  meta="$(nix flake metadata --json --no-write-lock-file . 2>/dev/null)"
  [[ "$meta" =~ \"path\":\"([^\"]+)\" ]] && current="${BASH_REMATCH[1]}"
  [[ -r "$applied_file" ]] && applied="$(<"$applied_file")"
  if [[ -n "$current" && "$current" != "$applied" ]]; then
    log_error "home-manager: current tree is not applied -> run: home-manager switch"
  fi
}

hm_notice
